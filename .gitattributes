# Standard: Git entscheidet, Zeilenenden im Repo immer LF
* text=auto eol=lf

# Alles, was auf dem Linux-Server laeuft, MUSS LF haben.
# Sonst: "bad interpreter: /bin/bash^M"
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile*   text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.conf        text eol=lf
.env.example  text eol=lf

# Scripts ohne Endung (z. B. scripts/calradia) einzeln nachtragen.

# Windows-seitige Helfer duerfen CRLF haben
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Binaeres nicht anfassen
*.png binary
*.jpg binary
*.gz  binary
*.zip binary
*.sav binary
