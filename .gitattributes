# Default: Git decides what is text, and text is always LF in the repository
* text=auto eol=lf

# Everything that runs on the Linux server MUST be LF. A CRLF checkout on
# Windows otherwise ends in "bad interpreter: /bin/bash^M" on the server.
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile*   text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.conf        text eol=lf
*.svg         text eol=lf
.env.example  text eol=lf

# Windows-side helpers may keep CRLF
*.ps1         text eol=crlf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Binary files are never touched
*.png binary
*.jpg binary
*.gz  binary
*.zip binary
*.7z  binary
*.sav binary

# Scripts without a file extension
bin/coop        text eol=lf
docker/coop-cmd text eol=lf
install.sh      text eol=lf
